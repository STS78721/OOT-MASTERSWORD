#version 450
#extension GL_GOOGLE_include_directive : require
#include "colour_vision.glsl"
// Colour adjustment + optional colour-vision correction on the present (vk_color.cpp): brightness, contrast around
// mid-grey, saturation against Rec. 709 luma, gamma, then luminance-preserving colourblind correction in linear light.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;   // the crop rectangle's corner in src
    ivec2 size;     // its size, the size of dst
    vec4 adj;       // brightness (added), contrast, saturation, gamma (exponent)
    int cv_mode;    // 0 Off, 1 Protan, 2 Deutan, 3 Tritan
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec3 c = texelFetch(src, p + pc.offset, 0).rgb;
    c += pc.adj.x;
    c = (c - 0.5) * pc.adj.y + 0.5;
    c = mix(vec3(dot(c, vec3(0.2126, 0.7152, 0.0722))), c, pc.adj.z);
    c = pow(max(c, vec3(0.0)), vec3(pc.adj.w));
    c = clamp(c, 0.0, 1.0);
    if (cv_enabled(pc.cv_mode)) {
        c = cv_encode_srgb(cv_correct(cv_decode_srgb(c), pc.cv_mode, false, 1.0));
    }
    imageStore(dst, p, vec4(clamp(c, 0.0, 1.0), 1.0));
}
