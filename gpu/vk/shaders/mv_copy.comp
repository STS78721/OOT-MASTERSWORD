#version 450
// Hybrid MVec (vk_mvec.cpp): copy/downsample colour history into the flow working size.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 offset; ivec2 size; } pc;
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    // Normalized UV over the destination — supports capping 4K → ≤1920 without corner-cropping.
    const vec2 uv = (vec2(g) + 0.5) / vec2(pc.size);
    imageStore(dst, g, vec4(textureLod(src, uv, 0.0).rgb, 1.0));
}
